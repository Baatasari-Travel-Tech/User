{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user",
  "main": ".open-next/worker.js",

  // Pin this. The Workers runtime is versioned by date, and leaving it floating
  // means a deploy months from now can behave differently to one today.
  "compatibility_date": "2026-08-12",

  // Required by the adapter: Next's server code uses Node APIs (Buffer, streams,
  // async_hooks) that the bare Workers runtime does not provide.
  "compatibility_flags": ["nodejs_compat"],

  // public/ plus the build output. `assets` serves these directly from
  // Cloudflare's edge without waking the Worker, which is what keeps static
  // files cheap and fast.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Where the ISR cache lives: Workers KV (free, nothing to rotate).
  //
  // The binding name is fixed by the adapter (kv-incremental-cache). The
  // namespace id is not a secret; it is bound to our Cloudflare account.
  // Replaces the Amazon S3 cache, 2026-10-21 (SESSION-QUEUE #43).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "7ee7c338c89d4ebc99b136ee5a541dc4"
    }
  ]
}
